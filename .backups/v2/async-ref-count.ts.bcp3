import { type Abortable, abortify } from '@xstd/abortable';
import {
  type CloseSharedAsyncDisposableRef,
  SharedAsyncDisposableRef,
} from '../shared-async-disposable-ref/shared-async-disposable-ref.ts';
import type { AsyncDisposableRef } from '../types/async-disposable-ref.ts';
import type { CloseAsyncDisposableRef } from '../types/close-async-disposable-ref.ts';
import type { OpenAsyncDisposableRef } from '../types/open-async-disposable-ref.ts';

/**
 * An async reference counter used to open a resource only once and share it multiple times.
 */
export class AsyncRefCount<GValue> {
  readonly #open: OpenAsyncDisposableRef<GValue>;

  #count: number;
  #step: 'closed' | 'opening' | 'opened' | 'closing';

  // opening
  #openController: AbortController | undefined;
  #openPromise: Promise<void> | undefined;

  // opened
  #value: GValue | undefined;
  #close: CloseAsyncDisposableRef | undefined;
  #closeShared: CloseSharedAsyncDisposableRef | undefined;

  // closing
  #closeController: AbortController | undefined;
  #closePromise: Promise<void> | undefined;

  constructor(open: OpenAsyncDisposableRef<GValue>) {
    this.#open = open;
    this.#step = 'closed';
    this.#count = 0;
  }

  #startOpening(): void {
    console.assert(this.#step === 'closed');
    this.#step = 'opening';
    const controller: AbortController = new AbortController();
    this.#openController = controller;
    this.#openPromise = Promise.try(this.#open, controller.signal).then(
      ({ value, close, closeShared }: AsyncDisposableRef<GValue>): void | Promise<void> => {
        this.#openController = undefined;
        this.#openPromise = undefined;

        this.#value = value;
        this.#close = close;
        this.#closeShared = closeShared;

        this.#step = 'opened';

        if (controller.signal.aborted) {
          console.warn("open's signal aborted but the promise resolved");
          this.#startClosing(controller.signal.aborted);

          return this.#closePromise!.then(
            (): never => {
              throw controller.signal.reason;
            },
            (error: unknown): never => {
              throw error === controller.signal.reason
                ? error
                : new SuppressedError(error, controller.signal.reason);
            },
          );
        }
      },
      (error: unknown): void => {
        this.#openController = undefined;
        this.#openPromise = undefined;

        this.#step = 'closed';

        throw error;
      },
    );
  }

  #startClosing(reason: unknown): void {
    console.assert(this.#step === 'opened');
    this.#step = 'closing';
    const controller: AbortController = new AbortController();
    this.#closeController = controller;
    this.#closePromise = Promise.try(this.#close!, reason, controller.signal).then(
      (): void => {
        this.#closeController = undefined;
        this.#closePromise = undefined;

        this.#value = undefined;
        this.#close = undefined;
        this.#closeShared = undefined;

        this.#step = 'closed';
      },
      (error: unknown): void => {
        this.#closeController = undefined;
        this.#closePromise = undefined;

        if (controller.signal.aborted) {
          // if "close" rejects due to its abortion, we "cancel" the closing, meaning we end in the "opened" state instead of "closed".
          if (error === controller.signal.reason) {
            this.#step = 'opened';

            if (this.#count === 1) {
              // TODO ?
              // this.#closeShared(error);
            }
          } else {
            console.warn(
              "The close promise was aborted, but the promise rejected with a different error than the signal's reason.",
            );
          }
        }

        if (this.#step !== 'opened') {
          this.#value = undefined;
          this.#close = undefined;
          this.#closeShared = undefined;

          this.#step = 'closed';
        }

        throw error;
      },
    );
  }

  async open({ signal }: Abortable = {}): Promise<SharedAsyncDisposableRef<GValue>> {
    signal?.throwIfAborted();

    this.#count++;

    try {
      if (this.#step === 'closing') {
        this.#closeController!.abort(
          new Error('Aborted while closing: "open" called while closing.'),
        );
        await abortify(
          this.#closePromise!.catch((): void => {}),
          { signal },
        );

        // @ts-ignore
        console.assert(this.#step === 'opened' || this.#step === 'closed');
      }

      if (this.#step === 'closed') {
        this.#startOpening();
        // @ts-ignore
        console.assert(this.#step === 'opening');
      }

      if (this.#step === 'opening') {
        await abortify(this.#openPromise!, { signal });
      }

      console.assert(this.#step === 'opened');

      return new SharedAsyncDisposableRef<GValue>(
        this.#value!,
        async (reason?: unknown): Promise<void> => {
          this.#count--;

          if (this.#count === 0) {
            this.#startClosing(reason);
          }

          if (this.#closeShared === undefined) {
            if (this.#step === 'closing') {
              await this.#closePromise!;
            }
          } else {
            await this.#closeShared(reason);
          }
        },
      );
    } catch (error: unknown) {
      this.#count--;

      if (this.#count === 0) {
        const resolveSubError = (subError: unknown): unknown => {
          return subError === error
            ? error
            : subError instanceof SuppressedError && subError.suppressed === error
              ? subError
              : new SuppressedError(subError, error);
        };

        if (this.#step === 'opening') {
          this.#openController!.abort(error);
          try {
            await this.#openPromise!;
          } catch (subError: unknown) {
            throw resolveSubError(subError);
          }
        } else {
          if (this.#step === 'opened') {
            this.#startClosing(error);
          }

          if (this.#step === 'closing') {
            try {
              await this.#closePromise!;
            } catch (subError: unknown) {
              throw resolveSubError(subError);
            }
          }
        }
      }

      throw error;
    }
  }
}
