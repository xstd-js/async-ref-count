import { type Abortable } from '@xstd/abortable';
import {
  type CloseSharedAsyncDisposableRef,
  SharedAsyncDisposableRef,
} from '../shared-async-disposable-ref/shared-async-disposable-ref.ts';
import type { AsyncDisposableRef } from '../types/async-disposable-ref.ts';
import type { CloseAsyncDisposableRef } from '../types/close-async-disposable-ref.ts';
import type { OpenAsyncDisposableRef } from '../types/open-async-disposable-ref.ts';

/**
 * An async reference counter used to open a resource only once and share it multiple times.
 */
export class AsyncRefCount<GValue> {
  readonly #open: OpenAsyncDisposableRef<GValue>;

  #count: number;
  #state: 'closed' | 'opening' | 'opened' | 'closing';

  #statePromise: Promise<readonly unknown[]> | undefined;
  #statePromiseErrorId: number;

  // opening
  #openController: AbortController | undefined;
  #openPromise: Promise<void> | undefined;

  // opened
  #value: GValue | undefined;
  #close: CloseAsyncDisposableRef | undefined;
  #closeShared: CloseSharedAsyncDisposableRef | undefined;

  // closing
  #closeReason: unknown | undefined;
  #closeController: AbortController | undefined;
  #closePromise: Promise<void> | undefined;

  constructor(open: OpenAsyncDisposableRef<GValue>) {
    this.#open = open;
    this.#state = 'closed';
    this.#statePromiseErrorId = 0;
    this.#count = 0;
  }

  async #updateState(): Promise<readonly ErrorWithId[]> {
    const errors: ErrorWithId[] = [];

    while (true) {
      try {
        if (this.#count === 0) {
          if (this.#state === 'closed') {
            break; // consistent state
          } else if (this.#state === 'opening') {
            this.#openController!.abort(
              this.#closeReason ?? new Error('Abort opening due to count being 0.'),
            );
            await this.#openPromise;
          } else if (this.#state === 'opened') {
            this.#state = 'closing';

            const controller: AbortController = new AbortController();
            this.#closeController = controller;

            await (this.#closePromise = Promise.try(
              this.#close!,
              this.#closeReason,
              controller.signal,
            ).then(
              (): void => {
                this.#closeReason = undefined;
                this.#closeController = undefined;
                this.#closePromise = undefined;

                this.#value = undefined;
                this.#close = undefined;
                this.#closeShared = undefined;

                this.#state = 'closed';
              },
              (error: unknown): never => {
                this.#closeReason = undefined;
                this.#closeController = undefined;
                this.#closePromise = undefined;

                if (controller.signal.aborted) {
                  // if "close" rejects due to its abortion, we "cancel" the closing, meaning we end in the "opened" state instead of "closed".
                  if (error === controller.signal.reason) {
                    this.#state = 'opened';
                    console.log('opened');
                  } else {
                    console.warn(
                      "The close promise was aborted, but the promise rejected with a different error than the signal's reason.",
                    );
                  }
                }

                if (this.#state !== 'opened') {
                  this.#value = undefined;
                  this.#close = undefined;
                  this.#closeShared = undefined;

                  this.#state = 'closed';
                }

                throw error;
              },
            ));
          } else /*if (this.#state === 'closing')*/ {
            await this.#closePromise;
          }
        } else {
          if (this.#state === 'closed') {
            this.#state = 'opening';

            const controller: AbortController = new AbortController();
            this.#openController = controller;

            await (this.#openPromise = Promise.try(this.#open, controller.signal).then(
              ({ value, close, closeShared }: AsyncDisposableRef<GValue>): void => {
                this.#openController = undefined;
                this.#openPromise = undefined;

                this.#value = value;
                this.#close = close;
                this.#closeShared = closeShared;

                this.#state = 'opened';

                if (controller.signal.aborted) {
                  console.warn('The open promise was aborted, but the promise resolved.');
                }
              },
              (error: unknown): never => {
                this.#openController = undefined;
                this.#openPromise = undefined;

                this.#state = 'closed';

                throw error;
              },
            ));
          } else if (this.#state === 'opening') {
            await this.#openPromise!;
          } else if (this.#state === 'opened') {
            break; // consistent state
          } else /*if (this.#state === 'closing')*/ {
            this.#closeController!.abort(
              new Error('Abort closing due to count being greater than 0.'),
            );
            await this.#closePromise;
          }
        }
      } catch (error: unknown) {
        errors.push({
          id: this.#statePromiseErrorId++,
          error,
        });
      }
    }

    return errors;
  }

  async #a(): Promise<void> {

  }

  async open({ signal }: Abortable = {}): Promise<SharedAsyncDisposableRef<GValue>> {
    signal?.throwIfAborted();

    this.#count++;

    if (this.#state === 'closing') {
      await new Promise<void>((resolve: () => void, reject: (reason: unknown) => void): void => {
        const onAbort = (): void => {
          signal!.removeEventListener('abort', onAbort);

          this.#count--;

          if (this.#count === 0) {
            this.#awaitClosing().then(
              (): void => {
                reject(signal!.reason);
              },
              (error: unknown): void => {
                reject(new SuppressedError(error, signal!.reason));
              },
            );
          } else {
            reject(signal!.reason);
          }
        };

        signal?.addEventListener('abort', onAbort);

        this.#stopClosing(new Error('Abort closing due to new opening.')).then(
          (): void => {
            signal?.removeEventListener('abort', onAbort);
            resolve();
          },
          (): void => {
            signal?.removeEventListener('abort', onAbort);
            resolve();
          },
        );
      });

      // @ts-ignore
      console.assert(this.#state === 'closed' || this.#state === 'opened');
    }

    try {
      if (this.#count === 1) {
        if (this.#state === 'opened') {
          await this.#startOpening();
        }
      } else {
        await this.#awaitOpening();
      }

      console.assert(this.#state === 'opened');

      return new SharedAsyncDisposableRef<GValue>(
        this.#value!,
        async (reason?: unknown): Promise<void> => {
          this.#closeReason = reason;

          const untilStateStable: Promise<void> = this.#updateCount(this.#count - 1);

          await (this.#closeShared === undefined ? untilStateStable : this.#closeShared(reason));
        },
      );
    } catch (error: unknown) {
      this.#count--;

      if (this.#count === 0) {
        if (this.#state === 'opening') {
        }
      }
      try {
        await this.#updateCount(this.#count - 1);
      } catch (chainedError: unknown) {
        throw resolveChainedError(error, chainedError);
      }

      throw error;
    }
  }
}

/* INTERNAL */

function resolveChainedError(rootError: unknown, chainedError: unknown): unknown {
  return chainedError === rootError
    ? rootError
    : chainedError instanceof SuppressedError && chainedError.suppressed === rootError
      ? chainedError
      : new SuppressedError(chainedError, rootError);
}

interface ErrorWithId {
  readonly id: number;
  readonly error: unknown;
}
